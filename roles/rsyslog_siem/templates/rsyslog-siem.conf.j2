# Managed by Ansible (roles/rsyslog_siem). Forwards security logs to the SIEM.
module(load="imfile")

# ─────────────────────────────────────────────
# GÖNDERİM KURALI (Ruleset)
# Hem auditd hem de sysmon bu ruleset'i kullanır.
# "stop": iletim sonrası mesaj yerel dosyalara yazılmaz (disk kalıntısı kalmaz).
# ─────────────────────────────────────────────
ruleset(name="SendToSIEM") {
    action(
        type="omfwd"
        target="{{ siem_host }}"
        port="{{ siem_port }}"
        protocol="{{ siem_protocol }}"
        template="RSYSLOG_ForwardFormat"
        queue.type="LinkedList"
        queue.filename="siem_queue"
        queue.maxdiskspace="{{ rsyslog_queue_maxchk }}"
        queue.saveonshutdown="on"
        action.resumeRetryCount="-1"
    )
    stop
}

# ─────────────────────────────────────────────
# AUDITD: kendi log dosyasını imfile ile oku ve gönder.
# Okuma izni auditd 'log_group' ile verilir (Debian: syslog; RHEL: root+SELinux).
# ─────────────────────────────────────────────
input(type="imfile"
      File="/var/log/audit/audit.log"
      Tag="auditd"
      Ruleset="SendToSIEM"
      freshStartTail="off"
)

# ─────────────────────────────────────────────
# SYSMON: Sysmon for Linux olayları doğrudan SYSLOG'a yazar (programname "sysmon",
# Provider "Linux-Sysmon"). Dosya/stdout YOK. Bu tag'i yakalayıp SIEM'e iletiyoruz.
# Bu dosya 30-... ön ekiyle 50-default'tan ÖNCE yüklendiğinden, "stop" sayesinde
# sysmon olayları yerel /var/log/syslog'a da düşmez.
# ─────────────────────────────────────────────
if ($programname == "sysmon") then {
    call SendToSIEM
}
