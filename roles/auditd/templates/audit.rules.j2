# Managed by Ansible (roles/auditd). Test on non-production first.
#
# SUPERSET: yeni SOC'un istediği kuralları (KENDİ key'leriyle → detection'ları
# eşleşsin) + bu projenin ek sıkılaştırma kurallarını (SOC'ta olmayanlar) birlikte
# yükler. Çakışan path'lerde SOC'un key'i kullanılır. Process/network/file execute
# görünürlüğü ayrıca Sysmon (ProcessCreate/NetworkConnect/FileCreate) ile gelir.

# Remove all existing rules
-D

# Buffer (backlog) size
-b 8192

# Failure mode (1: printk)
-f 1

# Continue loading remaining rules even if one fails (ör. bir binary yoksa)
-i

##########################################
####  SOC — Account / auth / identity
##########################################
-w /etc/sudoers -p wa -k sudo_conf
-w /etc/sudoers.d/ -p wa -k sudo_conf
-w /usr/bin/passwd -p x -k passwd_modification
-w /usr/sbin/groupadd -p x -k group_modification
-w /usr/sbin/groupmod -p x -k group_modification
-w /usr/sbin/addgroup -p x -k group_modification
-w /usr/sbin/useradd -p x -k user_modification
-w /usr/sbin/usermod -p x -k user_modification
-w /usr/sbin/adduser -p x -k user_modification
-w /etc/group -p wa -k etcgroup
-w /etc/passwd -p wa -k etcpasswd
-w /etc/gshadow -k etcgroup
-w /etc/shadow -k etcpasswd
-w /etc/security/opasswd -k opasswd
-w /etc/ssh/sshd_config -k sshd
-w /etc/pam.d/ -p wa -k pam_conf

##########################################
####  SOC — Recon / suspicious execution
##########################################
-w /etc/hostname -p r -k recon
-w /usr/bin/curl -p x -k susp_activity
-w /usr/bin/base64 -p x -k susp_activity
-w /bin/nc -p x -k susp_activity
-w /bin/netcat -p x -k susp_activity
-w /usr/bin/ncat -p x -k susp_activity
-w /usr/bin/ssh -p x -k susp_activity
-w /usr/bin/wireshark -p x -k susp_activity
-w /usr/bin/nmap -p x -k susp_activity

##########################################
####  SOC — Network config
##########################################
-w /etc/resolv.conf -p wa -k network_modifications
-w /etc/hosts -p wa -k network_modifications

##########################################
####  SOC — Cron / at
##########################################
-w /usr/bin/crontab -p x -k cron_cmd
-w /usr/sbin/cron -p x -k cron_service
-w /usr/sbin/atd -p x -k at_service
-w /etc/crontab -p wa -k cron_conf
-w /etc/cron.allow -p wa -k cron_conf
-w /etc/cron.deny -p wa -k cron_conf
-w /etc/cron.d/ -p wa -k cron_conf
-w /etc/cron.hourly/ -p wa -k cron_jobs
-w /etc/cron.daily/ -p wa -k cron_jobs
-w /etc/cron.weekly/ -p wa -k cron_jobs
-w /etc/cron.monthly/ -p wa -k cron_jobs
-w /var/spool/cron/ -p wa -k user_crontab
-w /var/spool/cron/crontabs/ -p wa -k user_crontab

##########################################
####  SOC — Kernel params / systemd / temp exec
##########################################
-w /etc/sysctl.conf -p wa -k sysctl_conf
-w /etc/sysctl.d/ -p wa -k sysctl_conf
-w /etc/systemd/system/ -p wa -k systemd_conf
-w /lib/systemd/system/ -p wa -k systemd_conf
-w /tmp/ -p x -k tmp_exec
-w /var/tmp/ -p x -k tmp_exec
-w /dev/shm/ -p x -k tmp_exec

# ==========================================================================
# Aşağısı: SOC'ta OLMAYAN, bu projenin eklediği ekstra sıkılaştırma kuralları.
# ==========================================================================

##########################################
####  Extra — Audit self-monitoring
##########################################
-w /etc/audit/ -p wa -k auditconfig
-w /etc/libaudit.conf -p wa -k auditconfig
-w /etc/audisp/ -p wa -k audispconfig
-w /sbin/auditctl -p x -k audittools
-w /sbin/auditd -p x -k audittools

##########################################
####  Extra — Privilege escalation (sudo exec)
##########################################
-w /usr/bin/sudo -p x -k sudo_execution
-w /etc/security/limits.conf -p wa -k pam_conf

##########################################
####  Extra — Host/network syscalls + NetworkManager
##########################################
-a always,exit -F arch=b32 -S sethostname -S setdomainname -k network_modifications
-a always,exit -F arch=b64 -S sethostname -S setdomainname -k network_modifications
-w /etc/sysconfig/network -p wa -k network_modifications
-w /etc/network/ -p wa -k network_modifications
-a always,exit -F dir=/etc/NetworkManager/ -F perm=wa -k network_modifications

##########################################
####  Extra — System state (shutdown/reboot)
##########################################
-w /sbin/shutdown -p x -k system_state_modifications
-w /sbin/poweroff -p x -k system_state_modifications
-w /sbin/reboot -p x -k system_state_modifications
-w /sbin/halt -p x -k system_state_modifications
-w /usr/sbin/runlevel -p x -k system_state_modifications

##########################################
####  Extra — Kernel modules
##########################################
-a always,exit -F perm=x -F auid!=-1 -F path=/sbin/insmod -k kernel_modules
-a always,exit -F perm=x -F auid!=-1 -F path=/sbin/modprobe -k kernel_modules
-a always,exit -F perm=x -F auid!=-1 -F path=/sbin/rmmod -k kernel_modules
-a always,exit -F perm=x -F auid!=-1 -F path=/sbin/kmod -k kernel_modules
-w /etc/modprobe.conf -p wa -k kernel_modules

##########################################
####  Extra — Login records
##########################################
-w /var/log/faillog -p wa -k login_modifications
-w /var/log/lastlog -p wa -k login_modifications
-w /var/log/tallylog -p wa -k login_modifications

##########################################
####  Extra — Process injection (ptrace)
##########################################
-a always,exit -F arch=b32 -S ptrace -k susp_activity
-a always,exit -F arch=b64 -S ptrace -k susp_activity

##########################################
####  Extra — Package logs, fstab, mounts
##########################################
-w /var/log/dpkg.log -p wa -k pkg_logs
-w /var/log/apt/history.log -p wa -k pkg_logs
-w /var/log/yum.log -p wa -k pkg_logs
-w /etc/fstab -p wa -k fstab_changes
-a always,exit -F arch=b64 -S mount -k mounts
-a always,exit -F arch=b32 -S mount -k mounts
